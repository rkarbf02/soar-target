# DVWA 3-Tier 공통 환경변수 템플릿
# 실제 사용 시 이 파일을 .env로 복사해서 값을 채운다:
#   cp .env.example .env
# .env는 .gitignore에 의해 커밋에서 제외된다.
# db/docker-compose.yml 과 was/docker-compose.yml 이 이 값을 함께 참조한다.

# MySQL root 비밀번호
MYSQL_ROOT_PASSWORD=rootpass

# DVWA 전용 DB / 계정
MYSQL_DATABASE=dvwa
MYSQL_USER=dvwa
MYSQL_PASSWORD=dvwapass

# db VM의 LAN2 IP (was의 DVWA가 이 주소로 접속)
DB_HOST=192.168.30.30
DB_PORT=3306
